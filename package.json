{
  "name": "expediente-local-qvac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx scripts/seed-synthetic.ts",
    "offline": "tsx scripts/verify-offline.ts",
    "measure": "tsx scripts/measure.ts",
    "qvac:smoke": "tsx scripts/qvac-smoke-test.ts",
    "qvac:offline-smoke": "tsx scripts/qvac-smoke-test.ts --offline",
    "publish:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1"
  },
  "dependencies": {
    "@qvac/sdk": "latest",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "12.4.1",
    "fastify": "^5.4.0",
    "minisearch": "latest",
    "pdf-parse": "latest",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
